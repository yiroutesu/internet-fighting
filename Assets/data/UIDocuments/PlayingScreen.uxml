<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/data/UIDocuments/HealthBar.uss?fileID=7433441132597879392&amp;guid=080795acdf013c74998e42bca5d3dca9&amp;type=3#HealthBar" />
    <Style src="project://database/Assets/data/UIDocuments/Attribute.uss?fileID=7433441132597879392&amp;guid=6777ce7378bfcb842871ffbbd8e659c4&amp;type=3#Attribute" />
    <ui:VisualElement style="flex-grow: 1;">
        <ui:ProgressBar value="22" title="my-progress" name="HealthBar" />
        <ui:VisualElement name="BarRoot" class="bar-root" style="width: 50%; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 1px; margin-right: 1px; margin-top: 1px; margin-bottom: 1px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; left: 50px; flex-basis: 2.5%; align-items: center; display: none;">
            <ui:VisualElement name="Bg" focusable="false" class="bar-bg" style="flex-grow: 1; width: 100%; height: 100%; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;" />
            <ui:VisualElement name="Fill" class="bar-fill" style="height: 50%; align-items: auto; align-self: center; justify-content: flex-start; flex-grow: 1; flex-direction: column; flex-wrap: nowrap; position: relative; margin-left: 2px; margin-right: 2px; margin-top: 2px; margin-bottom: 2px; width: 99.5%; -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;" />
            <ui:Label tabindex="-1" text="Label" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ValueText" class="bar-text" style="align-items: center; align-self: center;" />
        </ui:VisualElement>
        <ui:VisualElement name="AttrPanel" class="attr-panel" style="flex-grow: 1; width: 230px; margin-left: 5px; margin-right: 5px; margin-top: 5px; margin-bottom: 5px; padding-left: 2px; padding-right: 2px; padding-top: 2px; padding-bottom: 2px;" />
    </ui:VisualElement>
</ui:UXML>
